// Cloudflare Worker that serves the repo root as static assets. worker.js only runs first for the translated pages
// (locales/) and the street data for Neighborhood mode (/osm/, osm.js); everything else goes straight to the assets.
{
  "name": "color-world",
  "compatibility_date": "2026-10-16",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/osm/*", "/", "/en-gb", "/en-gb/*", "/es", "/es/*", "/fr", "/fr/*", "/de", "/de/*"]
  },
  // Checks the privacy safeguards (scripts/privacy.mjs, see PRIVACY.md), then builds <dir>/index.html for each locale
  // from index.html and locales/. wrangler runs this before every deploy, preview upload and `wrangler dev`,
  // so on deploys it runs after the Workers Builds build command (scripts/stamp.mjs) and copies the stamped page.
  "build": {
    "command": "node scripts/privacy.mjs && node scripts/locales.mjs"
  },
  // No request logs anywhere: Workers Logs and Logpush stay off, and worker.js and osm.js never call console.
  // scripts/privacy.mjs fails the build if either setting changes. See PRIVACY.md.
  "observability": { "enabled": false },
  "logpush": false,
  // Workers Builds runs `wrangler preview` for non-production branches, which needs this block.
  "previews": {}
}
