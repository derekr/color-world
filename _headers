# Cloudflare static asset response headers. In the repo, files aren't fingerprinted, so caches expire instead of
# being immutable: fonts rarely change; vendor and data get a week, then refresh in the background. index.html and
# *.js at the root keep Cloudflare's default (always revalidate) so app updates show up right away.
# The deploy build (node scripts/stamp.mjs --write) adds ?v=<content hash> to every reference and switches fonts/,
# vendor/, data/, app.js and datasets.js to a year, immutable.
/fonts/*
  Cache-Control: public, max-age=31536000
/vendor/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/data/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# Early Hints: with Early Hints on for the zone, Cloudflare caches these Link
# headers and sends them as a 103 before the page itself, so the browser starts
# fetching the critical files while it waits for the HTML. Keep in sync with
# the preloads at the top of index.html.
/
  Link: </fonts/baloo-2-latin-600-normal.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin
  Link: </fonts/baloo-2-latin-700-normal.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin
  Link: </fonts/baloo-2-latin-800-normal.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin
  Link: </vendor/datastar-rocket.js>; rel=modulepreload
  Link: </app.js>; rel=modulepreload
  Link: </datasets.js>; rel=modulepreload
  Link: </vendor/leaflet.js>; rel=preload; as=script
  Link: </vendor/topojson-client.min.js>; rel=preload; as=script
  Link: </data/world-110m.json>; rel=preload; as=fetch; crossorigin
  Link: </data/states-10m.json>; rel=preload; as=fetch; crossorigin
# The en-GB page (colour-world.perfectdays.dev, see worker.js) needs the same files. scripts/locales.mjs checks they match.
/en-gb/
